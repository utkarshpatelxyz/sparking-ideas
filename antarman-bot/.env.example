# ------------------------------------------------------------------
# AntarMan (अंतर्मन) — Environment Configuration
#
# 1. Copy this file and rename the copy to:  .env
# 2. Replace the placeholder below with your real Gemini API key.
#    Get a free key at: https://aistudio.google.com/app/apikey
# 3. NEVER commit your real .env file to GitHub.
# ------------------------------------------------------------------

# The port the local server will run on
PORT=5000

# Your free Google AI Studio (Gemini) API key
GEMINI_API_KEY=YOUR_FREE_GEMINI_API_KEY_HERE
